{
  "name": "cubeworld",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "cubeworld-db" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "MUNDOS", "class_name": "Mundo" },
      // las cuentas son las de Bodriostars: mismo objeto, así no se repiten nombres
      { "name": "CUENTAS", "class_name": "Cuentas", "script_name": "bodriostars" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Lobby", "Mundo"] }
  ],
  "observability": { "enabled": true }
}
